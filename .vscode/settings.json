{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "typescript"
  ],
  "css.customData": [
    ".vscode/tailwindcss.json"
  ],
  "emmet.includeLanguages": {
    "postcss": "css"
  },
  // Visual Studio Code Intellisense running very slow without this setting
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "nuxt.isNuxtApp": false
}